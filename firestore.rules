rules_version = '2';

// ============================================================
// Firestore セキュリティルール — 見積アプリ (mitsumori)
// 方針: 匿名認証(サインイン済み)のみ読み書き可 + 主要フィールドを検証
// ※ 本番環境モードの初期ルール(全拒否)から必ずこのルールへ差し替えてください
// ※ 検証は「型と長さの安全網」まで。業務ルール（計算式・状態遷移）は
//    アプリ側が持つ。開発が進んだフェーズで必要に応じて締める。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function strMax(v, max) {
      return v is string && v.size() <= max;
    }

    // 数値だが「まだ分からない」を null で持つ欄（請求額・人数・日数など）
    function numOrNull(v) {
      return v == null || v is number;
    }

    // 名前を持つマスタ（担当者・取引先・仕入先など）の共通チェック
    function validNamed(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100;
    }

    // ---- 設定（会社で1つ） ----
    // settings/rates: 率(小数)。material/labor/overhead/welfare/depreciation/tax/targetMargin
    // settings/unitRates: 職種1h単価6つ・車両円/km・移動労務円/h
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if signedIn();

      // 率と労務単価の変更履歴。誰が・いつ・どこの・何を・何から何に・なぜ。
      // 追記のみ、書き換えも消しも不可（あとから履歴をきれいにできない）。
      // scope の無い古い行は「会社の標準」として読む。
      match /history/{historyId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.at is timestamp
          && request.resource.data.get('scope', 'standard') in ['standard', 'customer']
          && strMax(request.resource.data.get('target', ''), 100)
          && strMax(request.resource.data.get('staff', ''), 60)
          && strMax(request.resource.data.get('key', ''), 60)
          && strMax(request.resource.data.get('label', ''), 60)
          && strMax(request.resource.data.get('unit', ''), 10)
          && strMax(request.resource.data.get('reason', ''), 100);
        allow update, delete: if false;
      }
    }

    // ---- 担当者 ----
    match /staff/{staffId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validNamed(request.resource.data);
      allow delete: if signedIn();
    }

    // ---- 取引先（宛先・元請け） ----
    // rates / unitRates は「元請けごと」の上書き（3段階の2段目）。
    // 元請けを先に登録する画面は作らない。見積の中で直して
    // 「次からも使う」を押したものだけが、ここに増える。
    match /customers/{customerId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && validNamed(request.resource.data)
        && strMax(request.resource.data.get('email', ''), 200)
        && request.resource.data.get('noWelfare', false) is bool
        // 法定福利費を分けて書く（元請けの書式指定）。既定 false。
        // 元請けへの確認が済むまで誰も true にしない。金額計算には効かない
        && request.resource.data.get('separateWelfare', false) is bool;
      allow delete: if signedIn();
    }

    // ---- 仕入先 ----
    match /suppliers/{supplierId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && validNamed(request.resource.data)
        && strMax(request.resource.data.get('email', ''), 200)
        && strMax(request.resource.data.get('mergeName', ''), 100)
        && request.resource.data.get('priceVolatile', false) is bool;
      allow delete: if signedIn();
    }

    // ---- 常設注番 ----
    match /standingOrders/{soId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && strMax(request.resource.data.orderNo, 30)
        && request.resource.data.orderNo.size() > 0
        && strMax(request.resource.data.get('staff', ''), 60)
        && validNamed(request.resource.data);
      allow delete: if signedIn();
    }

    // ---- 単価マスター（約1,600件） ----
    match /items/{itemId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && validNamed(request.resource.data)         // name は必須・一意はアプリ側で担保
        && strMax(request.resource.data.get('category', ''), 60)
        && strMax(request.resource.data.get('supplier', ''), 100)
        && strMax(request.resource.data.get('unit', ''), 20)
        && request.resource.data.get('cost', 0) is number
        && request.resource.data.get('useCount', 0) is number
        && request.resource.data.get('aliases', []) is list;
      allow delete: if signedIn();
    }

    // ---- 見積 ----
    // 下書きは工事名が空でも保存できる（現場で止まらないことを優先）ため、
    // 必須フィールドは課さない。型の安全網のみ。
    match /estimates/{estimateId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && strMax(request.resource.data.get('projectName', ''), 200)
        && strMax(request.resource.data.get('site', ''), 200)
        && strMax(request.resource.data.get('customer', ''), 100)
        && strMax(request.resource.data.get('orderNo', ''), 30)
        && strMax(request.resource.data.get('staff', ''), 60)
        && request.resource.data.get('status', '見積中') in ['見積中', '発注待ち', '進行中', '完工']
        && request.resource.data.get('welfareOn', false) is bool
        && request.resource.data.get('ratesEdited', false) is bool
        && request.resource.data.get('sketchPhotos', []) is list;
      allow delete: if signedIn();

      // 明細（材料／労務／移動／外注）
      // needsBreakdown / roughOrigin は概算から引き継いだ材料行の印。
      // 「一式いくら」を1本ずつに割り直す対象で、元が相場か手直しか単価待ちかを残す。
      match /lines/{lineId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.kind in ['材料', '労務', '移動', '外注']
          && strMax(request.resource.data.get('name', ''), 200)
          && request.resource.data.get('qty', 0) is number
          && request.resource.data.get('cost', 0) is number
          && request.resource.data.get('handwritten', false) is bool
          && request.resource.data.get('pendingPrice', false) is bool
          && request.resource.data.get('needsBreakdown', false) is bool;
        allow delete: if signedIn();
      }
    }

    // ---- 概算見積（AI概算・写真から見積） ----
    // 本見積(estimates)とは別に残す。上書きしない。
    // 現場で止まらないことを優先するので必須フィールドは課さない。型の安全網のみ。
    match /roughEstimates/{roughId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && strMax(request.resource.data.get('projectName', ''), 200)
        && strMax(request.resource.data.get('site', ''), 200)
        && strMax(request.resource.data.get('customer', ''), 100)
        && strMax(request.resource.data.get('orderNo', ''), 30)
        && strMax(request.resource.data.get('staff', ''), 60)
        && strMax(request.resource.data.get('oneLiner', ''), 500)
        && request.resource.data.get('status', '見積中') in ['見積中', '発注待ち', '進行中', '完工']
        && request.resource.data.get('workType', '修理・整備') in ['修理・整備', '製作もの', '配管工事']
        && request.resource.data.get('welfareOn', false) is bool
        && request.resource.data.get('photos', []) is list;
      allow delete: if signedIn();

      // 読み取った項目。AIが出したものは必ず '未確定' で入り、
      // 人が押して '確定' になったものだけが合計に入る（アプリ側の芯）。
      match /items/{itemId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.kind in ['材料', '労務', '移動', '外注']
          && request.resource.data.get('state', '未確定') in ['未確定', '確定', '単価待ち']
          && request.resource.data.get('chosen', null) in [null, 'yotsuba', 'market', 'manual']
          && strMax(request.resource.data.get('name', ''), 200)
          && strMax(request.resource.data.get('reason', ''), 100)
          && request.resource.data.get('steps', []) is list;
        allow delete: if signedIn();
      }

      // ききたいこと（AIが自信のないところ）
      match /questions/{questionId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && strMax(request.resource.data.get('text', ''), 500)
          && request.resource.data.get('kind', 'choice') in ['choice', 'photo', 'free']
          && request.resource.data.get('options', []) is list;
        allow delete: if signedIn();
      }

      // スケッチしてもらう（完成イメージ）
      match /sketches/{sketchId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && strMax(request.resource.data.get('prompt', ''), 500)
          && request.resource.data.get('proposedItems', []) is list;
        allow delete: if signedIn();
      }

      // 見積の中のやりとり。単独のチャット画面は作らない
      match /chat/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.get('role', 'user') in ['user', 'ai']
          && strMax(request.resource.data.get('text', ''), 4000)
          && strMax(request.resource.data.get('by', ''), 60);
        allow update: if false;
        allow delete: if signedIn();
      }
    }

    // ---- 実績（完工） ----
    // 概算・本見積とは別に残す。見積の金額は書き換えない。
    // 見積が無くても入れられる（社長の記憶から過去の工事を入れる用）ので、
    // roughId / estimateId は必須にしない。
    match /actuals/{actualId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.get('workType', '修理・整備') in ['修理・整備', '製作もの', '配管工事']
        && strMax(request.resource.data.get('projectName', ''), 200)
        && strMax(request.resource.data.get('customer', ''), 100)
        && strMax(request.resource.data.get('staff', ''), 60)
        && strMax(request.resource.data.get('note', ''), 500)
        && request.resource.data.get('source', 'app') in ['app', 'memory']
        // 思い出せない欄は null のまま入れられる。埋まっていなくても止めない
        && numOrNull(request.resource.data.get('billedAmount', 0))
        && numOrNull(request.resource.data.get('materialCost', 0))
        && numOrNull(request.resource.data.get('persons', 0))
        && numOrNull(request.resource.data.get('days', 0))
        && numOrNull(request.resource.data.get('roughTotal', 0))
        && numOrNull(request.resource.data.get('estimateTotal', 0));
      allow delete: if signedIn();
    }

    // ---- 覚えること ----
    // 項目を足す: 3件たまったら自動。金額を直す: 本人が押す＋理由。
    // 承認は挟まない。誰でも消せる（「いつでも消せる」が仕様）。
    match /memoryItems/{memoryId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && validNamed(request.resource.data)
        && request.resource.data.get('count', 0) is number
        && request.resource.data.get('adopted', false) is bool
        && request.resource.data.get('disabled', false) is bool
        && request.resource.data.get('occurrences', []) is list;
      allow delete: if signedIn();
    }

    match /memoryPrices/{memoryId} {
      allow read: if signedIn();
      // 理由の無い書き込みは弾く（誰が・いつ・なぜ が残らないものは覚えない）
      allow create, update: if signedIn()
        && validNamed(request.resource.data)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 100
        && strMax(request.resource.data.get('staff', ''), 60)
        && request.resource.data.get('disabled', false) is bool;
      allow delete: if signedIn();
    }

    // ---- 単価の判断待ち ----
    match /priceReviews/{reviewId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.get('status', '判断待ち') in ['判断待ち', '承認', '据え置き']
        && strMax(request.resource.data.get('reason', ''), 100)
        && strMax(request.resource.data.get('note', ''), 500);
      allow delete: if signedIn();
    }

    // ---- 接続テスト用（セットアップ確認ページが使用） ----
    match /diagnostics/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 上記以外は全面的に拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
